    "@typescript-eslint/parser": "^6.13.0",
    "dotenv": "^16.3.0",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.0",
    "hardhat": "^2.19.0",
    "hardhat-deploy": "^0.11.45",
    "solc": "^0.8.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
