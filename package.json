{
  "name": "homedao",
  "version": "1.0.0",
  "description": "Fractional real estate social network with DAO governance",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "hardhat:test": "cd hardhat && npx hardhat test",
    "hardhat:compile": "cd hardhat && npx hardhat compile",
    "hardhat:deploy": "cd hardhat && npx hardhat run scripts/deploy.js --network",
    "hardhat:deploy:testnet": "cd hardhat && npx hardhat run scripts/deploy.js --network sepolia",
    "hardhat:deploy:skale": "cd hardhat && npx hardhat run scripts/deploy.js --network skaleTestnet",
    "supabase:migrate": "supabase migration up",
    "supabase:reset": "supabase db reset"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.0",
    "@supabase/supabase-js": "^2.101.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.27",
    "ethers": "^5.8.0",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.292.0",
    "next": "^16.2.2",
    "postcss": "^8.5.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "stripe": "^22.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.0",
    "web3modal": "^1.9.12",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@chainlink/contracts": "^0.8.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
